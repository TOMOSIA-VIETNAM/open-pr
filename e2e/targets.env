# Fixture repos the e2e run pushes to. Override per vendor with --repo, e.g. a fork.
GITHUB_REPO=tms-minhtang1/open-pr-test
GITLAB_REPO=minhtang1/open-pr-test
GITLAB_HOST=gitlab.com
# Bitbucket Cloud: <workspace>/<repo-slug>. Auth is BITBUCKET_EMAIL + BITBUCKET_API_TOKEN
# (or BITBUCKET_TOKEN) in the environment — there is no CLI to log into.
BITBUCKET_REPO=tms-minhtang1/open-pr-test
